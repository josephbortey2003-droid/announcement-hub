# Public browser configuration from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential. Prefer the current sb_secret_ key. The
# service-role key is accepted only for older projects. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Hubtel SMS is disabled until every value is configured and the switch is true.
# Copy the exact API base URL shown in your Hubtel portal. It should normally end
# in /v1/messages; the app appends /send and /{messageId}.
HUBTEL_SMS_ENABLED=false
HUBTEL_SMS_MODE=test
HUBTEL_SMS_BASE_URL=https://your-hubtel-api-host/v1/messages
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

# Required in test mode. Comma-separated E.164 numbers, for example +233...
HUBTEL_SMS_TEST_RECIPIENTS=
