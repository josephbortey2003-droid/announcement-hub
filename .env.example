# Public browser configuration from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never prefix secret or service-role keys with NEXT_PUBLIC_.
# Add server-only provider credentials only when the related integration is built.
SMS_PROVIDER=
SMS_PROVIDER_CLIENT_ID=
SMS_PROVIDER_CLIENT_SECRET=
